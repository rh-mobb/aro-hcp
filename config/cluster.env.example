# Azure region (must be ARO HCP allow-listed)
LOCATION=uksouth

# Resource naming
CLUSTER_NAME=my-cluster
RESOURCE_GROUP=my-cluster-rg
MANAGED_RESOURCE_GROUP=my-cluster-managed

# Network
VNET_NAME=customer-vnet
SUBNET_NAME=customer-subnet-1
VNET_INTEGRATION_SUBNET_NAME=customer-vnet-integration-subnet
NSG_NAME=customer-nsg

# Cluster version (from: make versions)
CLUSTER_VERSION=4.22
CLUSTER_CHANNEL=stable

# Default node pool
NODEPOOL_NAME=np-1
NODEPOOL_REPLICAS=2
NODEPOOL_VM_SIZE=Standard_D4s_v6
NODEPOOL_VERSION=4.22.9
NODEPOOL_CHANNEL=stable

# Paths (repo-local)
KUBECONFIG_PATH=.kube/config
ARO_HCP_WHEEL_URL=https://github.com/bennerv/ARO-HCP/releases/download/0.0.2/aro_hcp-1.0.0b2-py3-none-any.whl

# External auth (optional; used by make external-auth)
EXTERNAL_AUTH_NAME=entra
APP_DISPLAY_NAME=

# API version for REST fallbacks
API_VERSION=2026-06-30-preview

# API visibility: Public (default) or Private. Create-time only; cannot change in place.
# API_VISIBILITY=Public

# Optional Fedora jump VM + public IP for sshuttle into the VNet.
ENABLE_JUMPBOX=false
# Required when ENABLE_JUMPBOX=true. SSH 22 allowed from this CIDR only (use your /32).
JUMP_SSH_SOURCE_PREFIX=
# Public key file for the jump VM (private key is config/jump). Created by: make jump-key
JUMP_SSH_PUBLIC_KEY_PATH=config/jump.pub
