#!/usr/bin/env bash
# Mock terraform for bats tests.
set -euo pipefail

if [[ "${1:-}" == -chdir=* ]]; then
  shift
elif [[ "${1:-}" == "-chdir" ]]; then
  shift 2
fi

sub="${1:-}"
shift || true

case "${sub}" in
  output)
    flag="${1:-}"
    name="${2:-}"
    if [[ "${flag}" == "-json" ]]; then
      cat <<'JSON'
{
  "identity_ids": {
    "value": {
      "service": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/svc",
      "cluster_api_azure": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/capi",
      "control_plane": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/cp",
      "cloud_controller_manager": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/ccm",
      "ingress": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/ingress",
      "disk_csi_driver": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/disk",
      "file_csi_driver": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/file",
      "image_registry": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/image",
      "cloud_network_config": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/cloudnet",
      "kms": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/kms",
      "dp_disk_csi_driver": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/dpdisk",
      "dp_file_csi_driver": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/dpfile",
      "dp_image_registry": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/dpimage"
    }
  }
}
JSON
    elif [[ "${flag}" == "-raw" ]]; then
      case "${name}" in
        subnet_id) echo "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.Network/virtualNetworks/vnet/subnets/worker" ;;
        vnet_integration_subnet_id) echo "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.Network/virtualNetworks/vnet/subnets/integration" ;;
        nsg_id) echo "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.Network/networkSecurityGroups/nsg" ;;
        key_vault_name) echo "cust-kv-test" ;;
        etcd_key_version) echo "abc123" ;;
        *) echo "mock" ;;
      esac
    fi
    ;;
  *)
    if [[ "${sub}" == "state" ]]; then
      action="${1:-}"
      case "${action}" in
        list)
          if [[ "${TF_STATE_HAS_CLUSTER:-1}" == "1" ]]; then
            echo "azapi_resource.hcp_cluster"
          fi
          if [[ "${TF_STATE_HAS_NODE_POOL:-1}" == "1" ]]; then
            echo "azapi_resource.node_pool"
          fi
          ;;
        rm)
          echo "terraform state rm ${2:-}"
          ;;
        *)
          echo "mock terraform: state ${action}" >&2
          ;;
      esac
    elif [[ "${sub}" == "destroy" ]]; then
      echo "terraform destroy $*"
    else
      echo "mock terraform: ${sub} $*" >&2
    fi
    exit 0
    ;;
esac
