#!/usr/bin/env bash
# Mock terraform for bats tests.
set -euo pipefail

if [[ "${1:-}" == -chdir=* ]]; then
  shift
elif [[ "${1:-}" == "-chdir" ]]; then
  shift 2
fi

sub="${1:-}"
shift || true

case "${sub}" in
  output)
    flag="${1:-}"
    name="${2:-}"
    if [[ "${flag}" == "-json" ]]; then
      case "${name}" in
        identity_ids)
          cat <<'JSON'
{
  "service": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/svc",
  "cluster_api_azure": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/capi",
  "control_plane": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/cp",
  "cloud_controller_manager": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/ccm",
  "ingress": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/ingress",
  "disk_csi_driver": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/disk",
  "file_csi_driver": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/file",
  "image_registry": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/image",
  "cloud_network_config": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/cloudnet",
  "kms": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/kms",
  "dp_disk_csi_driver": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/dpdisk",
  "dp_file_csi_driver": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/dpfile",
  "dp_image_registry": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/dpimage"
}
JSON
          ;;
        platform)
          cat <<'JSON'
{
  "contract_version": 1,
  "subscription_id": "00000000-0000-0000-0000-000000000004",
  "tenant_id": "00000000-0000-0000-0000-000000000001",
  "location": "uksouth",
  "cluster_name": "test-cluster",
  "cluster_id": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.RedHatOpenShift/hcpOpenShiftClusters/test-cluster",
  "resource_group_name": "test-rg",
  "network": {
    "vnet_id": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.Network/virtualNetworks/vnet",
    "vnet_name": "test-cluster-vnet",
    "address_prefix": "10.0.0.0/16",
    "worker_subnet_id": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.Network/virtualNetworks/vnet/subnets/worker",
    "worker_subnet_name": "test-cluster-worker",
    "worker_subnet_prefix": "10.0.0.0/24",
    "nsg_id": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.Network/networkSecurityGroups/nsg",
    "jump_subnet_prefix": "10.0.2.0/28",
    "reserved": {
      "netapp_subnet_prefix": "10.0.3.0/24"
    }
  },
  "oidc_issuer_url": "https://uksouth.oic.aro.azure.com/tenant/test",
  "key_vault_id": "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.KeyVault/vaults/cust-kv-test",
  "key_vault_name": "cust-kv-test",
  "key_vault_uri": "https://cust-kv-test.vault.azure.net/",
  "eso_client_id": "00000000-0000-0000-0000-000000000099",
  "api_url": "https://api.test-cluster.example.com:443",
  "api_visibility": "Public",
  "cluster_version": "4.22",
  "node_pool_version": "4.22.9"
}
JSON
          ;;
      esac
    elif [[ "${flag}" == "-raw" ]]; then
      case "${name}" in
        cluster_name) echo "test-cluster" ;;
        resource_group_name) echo "test-rg" ;;
        location) echo "uksouth" ;;
        managed_resource_group_name) echo "test-cluster-managed" ;;
        cluster_version) echo "4.20" ;;
        cluster_channel) echo "candidate" ;;
        node_pool_name) echo "np-1" ;;
        node_pool_replicas) echo "2" ;;
        node_pool_vm_size) echo "Standard_D4s_v6" ;;
        node_pool_version) echo "4.20.29" ;;
        node_pool_channel) echo "candidate" ;;
        api_visibility) echo "Public" ;;
        ingress_visibility) echo "Public" ;;
        subnet_id) echo "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.Network/virtualNetworks/vnet/subnets/worker" ;;
        vnet_integration_subnet_id) echo "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.Network/virtualNetworks/vnet/subnets/integration" ;;
        nsg_id) echo "/subscriptions/sub/resourceGroups/rg/providers/Microsoft.Network/networkSecurityGroups/nsg" ;;
        key_vault_name) echo "cust-kv-test" ;;
        key_vault_uri) echo "https://cust-kv-test.vault.azure.net/" ;;
        tenant_id) echo "00000000-0000-0000-0000-000000000001" ;;
        eso_client_id) echo "00000000-0000-0000-0000-000000000099" ;;
        pull_secret_key_vault_secret_name) echo "redhat-pull-secret" ;;
        etcd_key_version) echo "abc123" ;;
        jump_public_ip)
          if [[ "${TF_MOCK_JUMP:-}" == "1" ]]; then
            echo "203.0.113.10"
          else
            echo ""
          fi
          ;;
        jump_ssh_user)
          if [[ "${TF_MOCK_JUMP:-}" == "1" ]]; then
            echo "fedora"
          else
            echo ""
          fi
          ;;
        jump_sshuttle_command)
          if [[ "${TF_MOCK_JUMP:-}" == "1" ]]; then
            echo 'sshuttle -r fedora@203.0.113.10 --dns -e "ssh -i jump" 10.0.0.0/16'
          else
            echo ""
          fi
          ;;
      esac
    fi
    ;;
  *)
    if [[ "${sub}" == "state" ]]; then
      action="${1:-}"
      case "${action}" in
        list)
          if [[ "${TF_STATE_HAS_CLUSTER:-1}" == "1" ]]; then
            echo "module.cluster.azapi_resource.hcp_cluster"
          fi
          if [[ "${TF_STATE_HAS_NODE_POOL:-1}" == "1" ]]; then
            echo 'module.cluster.azapi_resource.node_pool["np-1"]'
          fi
          ;;
        rm)
          echo "terraform state rm ${2:-}"
          ;;
        *)
          echo "mock terraform: state ${action}" >&2
          ;;
      esac
    elif [[ "${sub}" == "destroy" ]]; then
      echo "terraform destroy $*"
    else
      echo "mock terraform: ${sub} $*" >&2
    fi
    exit 0
    ;;
esac
